{
  "manifest_version": 3,
  "name": "YouTube Downloader",
  "version": "1.4.1",
  "description": "Скачивает ролик YouTube через yt-dlp в выбранном разрешении.",
  "permissions": [
    "nativeMessaging",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Downloader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "key": ""
}
